<IfModule mod_rewrite.c>
    RewriteEngine On

    # Evitar que index.php aparezca en la URL publica.
    RewriteCond %{THE_REQUEST} \s/+.*index\.php(?:[?\s]) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)index\.php$ [NC]
    RewriteRule ^index\.php$ %1 [R=301,L,NE]

    # Ruta publica corta para el articulo de Salmonella.
    RewriteCond %{THE_REQUEST} \s/+.*blog/salmonella-enteritidis-typhimurium\.php(?:[?\s]) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)blog/salmonella-enteritidis-typhimurium\.php$ [NC]
    RewriteRule ^blog/salmonella-enteritidis-typhimurium\.php$ %1blog/salmonella/ [R=301,L,NE]
    RewriteRule ^blog/salmonella/?$ blog/salmonella-enteritidis-typhimurium.php [L,QSA]

    # La maqueta inmersiva no publicada depende de recursos que no forman parte del sitio.
    RewriteCond %{THE_REQUEST} \s/+.*soluciones/ingredientes_inmersivo_actual\.php(?:[?\s]) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)soluciones/ingredientes_inmersivo_actual\.php$ [NC]
    RewriteRule ^soluciones/ingredientes_inmersivo_actual\.php$ %1soluciones/ingredientes.php [R=301,L,NE]

    # Redirección de recursos heredados a la nueva estructura de assets/
    RewriteRule ^img/(.*)$ assets/img/$1 [L,R=301]
    RewriteRule ^css/(.*)$ assets/css/$1 [L,R=301]
    RewriteRule ^js/(.*)$ assets/js/$1 [L,R=301]
    RewriteRule ^fonts/(.*)$ assets/fonts/$1 [L,R=301]
    RewriteRule ^catalogos/(.*\.pdf)$ assets/docs/catalogos/$1 [L,R=301]
    RewriteRule ^public/docs/(.*)$ assets/docs/politicas/$1 [L,R=301]
    RewriteRule ^public/img/(.*)$ assets/img/$1 [L,R=301]
    RewriteRule ^public/(.*)$ assets/img/$1 [L,R=301]

    # Mostrar la pagina corporativa de error y conservar el estado HTTP 404.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>
